<div class="page-head"><div><h1>Traders</h1>
  <p class="small" style="margin:4px 0 0">Simulated copy-trading strategies. You manage each strategy's profile, visibility and followers. Return, win rate and follower counts are calculated from the simulated trades and real follows, so they can't be edited.</p></div></div>
<% if (it.ok) { %><div class="notice notice-ok">Saved.</div><% } %>
<% if (it.error) { %><div class="notice notice-err"><%= it.error %></div><% } %>

<div class="grid grid-admin-split">
  <div class="table-wrap" style="height:fit-content">
    <table>
      <thead><tr><th>Strategy</th><th class="num">Trades</th><th class="num">Win rate</th><th class="num">Net P&amp;L</th><th class="num">Copying</th><th></th></tr></thead>
      <tbody>
        <% if (!it.rows.length) { %><tr><td colspan="6"><div class="empty"><h4>No traders yet</h4></div></td></tr><% } %>
        <% it.rows.forEach(function(t){ %>
          <tr style="<%= t.active ? '' : 'opacity:.6' %>">
            <td><a href="/admin/traders/<%= t.id %>"><b><%= t.displayName %></b></a>
              <% if (!t.active) { %> <span class="badge badge-idle">hidden</span><% } %>
              <div class="small muted"><%= t.strategy %> · risk <%= t.riskScore %>/10 · min <%= it.usd(t.minCopy, 0) %></div></td>
            <td class="num"><%= t.closedTrades %></td>
            <td class="num"><%= t.winRate.toFixed(1) %>%</td>
            <td class="num <%= it.dir(t.totalPnl) %>"><%= it.signedUsd(t.totalPnl) %></td>
            <td class="num"><%= t.followers %></td>
            <td style="text-align:right;white-space:nowrap">
              <a class="btn btn-quiet btn-sm" href="/admin/traders/<%= t.id %>">Manage</a>
              <form method="post" action="/admin/traders/<%= t.id %>/toggle" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                <button class="btn btn-quiet btn-sm"><%= t.active ? 'Hide' : 'Show' %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <div class="card-head"><h3>Add a trader</h3></div>
    <form method="post" action="/admin/traders">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <%~ include('../partials/trader-form', { t: null, pre: 'new', strategies: it.strategies, markets: it.markets }) %>
      <button class="btn btn-primary btn-block btn-sm">Create trader</button>
    </form>
  </div>
</div>
